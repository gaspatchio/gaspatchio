  "sources": [
    {
      "path": "model.py",
      "fingerprint": "sha256:3bd9ec506705fded28754348575ef5938cec38641d5b7b92534443a7e5aacab0",
      "payload": {
        "text": "# SPDX-FileCopyrightText: 2026 Opio Inc.\n#\n# SPDX-License-Identifier: Apache-2.0\n\n\"\"\"Single-state separate-account accumulation, as a model the CLI can run.\n\nThe tutorial pattern `rollforward-patterns/01_single_state_fund.py` builds\nits own frame and prints; this is the same three Ops over one state, written\nas a `main(af)` so `gspio calc-graph` can run it over a model-points file and\nrecord what it did. Two policies, twelve monthly periods:\n\n    AV_eop = max( AV_bop * (1 + fund_return) * (1 - me_charge), 0 )\n\nReference: Hardy (2003), *Investment Guarantees*, section 6.3.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\n\nfrom gaspatchio import ActuarialFrame\nfrom gaspatchio.rollforward._compile import compile_rollforward\n\nN_PERIODS = 12\n\n\ndef main(af: ActuarialFrame) -> ActuarialFrame:\n    \"\"\"Grow the account, take the charge, floor it, and say what it gained.\"\"\"\n    af = af.projection.set(\n        start_date=date(2025, 1, 31),\n        n_periods=N_PERIODS,\n        frequency=\"monthly\",\n    )\n\n    # No per-policy contract end here: a fixed horizon over every policy, so\n    # `contract_boundary=` is omitted and the kernel runs every period.\n    b = af.projection.rollforward(states={\"av\": af[\"av_init\"]})\n    (\n        b[\"av\"]\n        .grow(af[\"fund_return\"], label=\"fund_return\")\n        .charge(af[\"me_charge\"], label=\"me_charge\")\n        .floor(value=0.0)\n    )\n\n    compiled = compile_rollforward(b)\n    af.av = compiled.expr_for(\"av\")\n\n    af.av_growth = af.av - af.av_init\n\n    return af\n"
      }
    }
  ],

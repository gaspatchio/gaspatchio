      "path": "model.py",
      "fingerprint": "sha256:8a78b21e28c3fc02d567e4c48b8603f38a692482d77f29dd1199a565cf4d95b3",
      "payload": {
        "text": "# SPDX-FileCopyrightText: 2026 Opio Inc.\n#\n# SPDX-License-Identifier: Apache-2.0\n\n\"\"\"A twelve-month reserve, written once and then floored at zero.\n\nThe point of this model is the second assignment. `reserve` is defined, and\nthen defined again over the top of it, so the artifact carries two accounts\nof one column: the definition the frame ended up holding, and the one it\nwrote over. That is what a reader meets as the versions badge on a node.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import date\n\nfrom gaspatchio import ActuarialFrame, when\n\n\ndef main(af: ActuarialFrame) -> ActuarialFrame:\n    \"\"\"Earn the premium, incur the claims, and floor what is left at zero.\"\"\"\n    af = af.projection.set(start_date=date(2025, 1, 31), n_periods=12, frequency=\"monthly\")\n\n    af.premium_earned = af.annual_premium * af.month / 12\n    af.claims_incurred = af.sum_assured * af.mortality_rate * af.month / 12\n\n    # Written once, as the difference the two sides come to, and then written\n    # again with the floor on it. Both definitions travel.\n    af.reserve = af.claims_incurred - af.premium_earned\n\n    af.reserve = when(af.reserve < 0).then(0.0).otherwise(af.reserve)\n\n    return af\n"
      }
    }
  ],

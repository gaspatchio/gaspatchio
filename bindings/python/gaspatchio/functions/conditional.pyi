# ABOUTME: Type stubs for conditional expressions (when/then/otherwise)
# ABOUTME: Provides type hints for Excel-style IF() with list broadcasting

from typing import Any, ClassVar, NoReturn

import polars as pl

from gaspatchio._semantic.ir import OpNode
from gaspatchio.column.expression_proxy import ExpressionProxy
from gaspatchio.frame.base import ActuarialFrame

class ConditionalProxy:
    def __init__(self, condition: OpNode, parent: ActuarialFrame | None) -> None: ...
    def then(self, value: Any) -> ConditionalProxy: ...  # noqa: ANN401
    def when(self, condition: Any) -> ConditionalProxy: ...  # noqa: ANN401
    def otherwise(self, value: Any) -> ExpressionProxy: ...  # noqa: ANN401
    def needs_list_broadcasting(self) -> bool: ...
    def _to_expr(self) -> pl.Expr: ...
    def _refuse_unfinished(self, *_operands: object) -> NoReturn: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]
    def __eq__(self, *_operands: object) -> NoReturn: ...
    def __ne__(self, *_operands: object) -> NoReturn: ...
    def __lt__(self, *_operands: object) -> NoReturn: ...
    def __le__(self, *_operands: object) -> NoReturn: ...
    def __gt__(self, *_operands: object) -> NoReturn: ...
    def __ge__(self, *_operands: object) -> NoReturn: ...
    def __and__(self, *_operands: object) -> NoReturn: ...
    def __rand__(self, *_operands: object) -> NoReturn: ...
    def __or__(self, *_operands: object) -> NoReturn: ...
    def __ror__(self, *_operands: object) -> NoReturn: ...
    def __xor__(self, *_operands: object) -> NoReturn: ...
    def __rxor__(self, *_operands: object) -> NoReturn: ...
    def __add__(self, *_operands: object) -> NoReturn: ...
    def __radd__(self, *_operands: object) -> NoReturn: ...
    def __sub__(self, *_operands: object) -> NoReturn: ...
    def __rsub__(self, *_operands: object) -> NoReturn: ...
    def __mul__(self, *_operands: object) -> NoReturn: ...
    def __rmul__(self, *_operands: object) -> NoReturn: ...
    def __truediv__(self, *_operands: object) -> NoReturn: ...
    def __rtruediv__(self, *_operands: object) -> NoReturn: ...
    def __floordiv__(self, *_operands: object) -> NoReturn: ...
    def __rfloordiv__(self, *_operands: object) -> NoReturn: ...
    def __mod__(self, *_operands: object) -> NoReturn: ...
    def __rmod__(self, *_operands: object) -> NoReturn: ...
    def __pow__(self, *_operands: object) -> NoReturn: ...
    def __rpow__(self, *_operands: object) -> NoReturn: ...
    def __neg__(self, *_operands: object) -> NoReturn: ...
    def __pos__(self, *_operands: object) -> NoReturn: ...
    def __abs__(self, *_operands: object) -> NoReturn: ...
    def __invert__(self, *_operands: object) -> NoReturn: ...
    def __bool__(self, *_operands: object) -> NoReturn: ...

def when(condition: Any) -> ConditionalProxy: ...  # noqa: ANN401

# What the API reference documents from this module.
__all__ = ["ConditionalProxy", "when"]

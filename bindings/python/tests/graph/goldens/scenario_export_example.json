 "sources": [
  {
   "path": "model.py",
   "fingerprint": "sha256:7979eb453be628fb32772701c19072190ff9818f7818732462e404dadc771c7d",
   "payload": {
    "text": "\"\"\"A two-column model, for a checked-in scenario export.\"\"\"\n\nimport polars as pl\n\nfrom gaspatchio import ActuarialFrame\n\n\ndef main(af: ActuarialFrame, params=None) -> ActuarialFrame:\n    del params\n    af.shocked_rate = af.base_rate * pl.when(pl.col(\"scenario_id\") == \"STRESS\").then(1.5).otherwise(1.0)\n    af.loss = af.sum_assured * af.shocked_rate\n    return af\n"
   }
  },
  {
   "path": "run_scenarios.py",
   "fingerprint": "sha256:69d2351ac7b2a4494ebc33cf5aad5a5679473c089946a59c4235ae134e10fb31",
   "payload": {
    "text": "\"\"\"The plan this export is an account of.\"\"\"\n\nimport polars as pl\n\nfrom gaspatchio import ActuarialFrame, ScenarioRun\nfrom gaspatchio.scenarios import Sum\n\nimport model\n\n\ndef model_fn(af: ActuarialFrame, *, tables: dict, drivers: dict) -> ActuarialFrame:\n    del tables, drivers\n    return model.main(af)\n\n\nSCENARIO_RUN = ScenarioRun(\n    shocks={\"BASE\": [], \"STRESS\": []},\n    base_tables={},\n    aggregations=(Sum(\"loss\").alias(\"loss\").over(\"scenario_id\"),),\n)\nMODEL_FN = model_fn\n"
   }
  }
 ],
